root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2


[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespace com escopo de arquivo: um nível de indentação a menos em todo
# arquivo, sem ganho nenhum em manter o bloco.
csharp_style_namespace_declarations = file_scoped:warning

# `var` quando o tipo está à vista do lado direito; tipo explícito quando
# não está. Ler `var x = Calcular();` obriga a abrir o método para saber o
# que voltou.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:warning

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_readonly_field = true:warning

# Campos privados com sublinhado; o resto segue o padrão do .NET.
dotnet_naming_rule.campos_privados.symbols = campos_privados
dotnet_naming_rule.campos_privados.style = sublinhado_camel
dotnet_naming_rule.campos_privados.severity = suggestion
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_symbols.campos_privados.required_modifiers =
dotnet_naming_style.sublinhado_camel.capitalization = camel_case
dotnet_naming_style.sublinhado_camel.required_prefix = _

# Constantes e campos estáticos somente leitura em PascalCase, sem prefixo.
dotnet_naming_rule.constantes.symbols = constantes
dotnet_naming_rule.constantes.style = pascal
dotnet_naming_rule.constantes.severity = suggestion
dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.estaticos_readonly.symbols = estaticos_readonly
dotnet_naming_rule.estaticos_readonly.style = pascal
dotnet_naming_rule.estaticos_readonly.severity = suggestion
dotnet_naming_symbols.estaticos_readonly.applicable_kinds = field
dotnet_naming_symbols.estaticos_readonly.required_modifiers = static, readonly

# ADR-0001: os nomes do domínio são em português. A regra que exige o
# sufixo "Exception" em exceções pressupõe nomes em inglês; `ExcecaoDeDominio`
# já diz o que é, e `ExcecaoDeDominioException` não ajudaria ninguém.
dotnet_diagnostic.CA1710.severity = none

[tests/**.cs]
# Nome de teste é frase: `Rejeita_dependencia_que_fecharia_ciclo` se lê;
# `RejeitaDependenciaQueFechariaCiclo` não. A regra que proíbe sublinhado
# em identificador vale para código de produção, não para teste.
dotnet_diagnostic.CA1707.severity = none
