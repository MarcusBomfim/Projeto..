<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A API REST: o contrato HTTP do CRM. Autentica, autoriza, traduz pedidos em
    chamadas ao domínio e erros em ProblemDetails. Regra de negócio aqui não
    há — está no domínio.
  -->
  <PropertyGroup>
    <RootNamespace>CrmObras.Api</RootNamespace>
    <!-- Onde o dotnet user-jwts guarda a chave dos tokens de desenvolvimento. -->
    <UserSecretsId>crm-obras-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CrmObras.Infraestrutura\CrmObras.Infraestrutura.csproj" />
    <ProjectReference Include="..\CrmObras.Observabilidade\CrmObras.Observabilidade.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CrmObras.Api.Testes" />
  </ItemGroup>
</Project>
